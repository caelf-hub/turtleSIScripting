{
  "name": "LeRobot",
  "dockerComposeFile": ["../docker/compose.yaml"],
  "service": "lerobot",
  "workspaceFolder": "/workspaces/lerobot",
  "shutdownAction": "stopContainer",
  "remoteUser": "user_lerobot",
  "postStartCommand": "sh /workspaces/lerobot/docker/container-welcome.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "ms-vscode.vscode-serial-monitor"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/lerobot/.venv/bin/python",
        "python.terminal.activateEnvironment": true,
        "python.terminal.useEnvFile": true,
        "python.analysis.extraPaths": ["/workspaces/lerobot/src"],
        "python.envFile": "/workspaces/lerobot/.env",
        "terminal.integrated.cwd": "/workspaces/lerobot",
        "terminal.integrated.env.linux": {
          "PYTHONPATH": "/workspaces/lerobot/src"
        }
      }
    }
  }
}
